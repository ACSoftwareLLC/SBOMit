{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sbomit-test",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "comment": "Vitest pool config. Mirrors wrangler.jsonc bindings but keeps the OpenNext generated worker as main so the test pool does not try to bundle the custom worker.ts entry (which imports .open-next/worker.js).",

  "main": ".open-next/worker.js",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sbomit-deps",
      "database_id": "test",
      "migrations_dir": "./migrations"
    }
  ]
}
